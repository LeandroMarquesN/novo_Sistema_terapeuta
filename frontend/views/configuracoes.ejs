    </main>

    <!-- ─── Modal de Sucesso ─── -->
    <div id="modalSucesso" class="fixed inset-0 z-[100] flex items-center justify-center hidden">
        <div class="absolute inset-0" style="background:rgba(2,12,18,0.7);backdrop-filter:blur(8px)"></div>

        <div class="glass-card relative w-full max-w-sm p-8 text-center scale-90 opacity-0 transition-all duration-300 ease-out" id="modalCard">
            <div class="modal-success-icon">
                <i class="fas fa-check-circle"></i>
            </div>
            <h3 class="modal-success-title mb-2">Sucesso!</h3>
            <p class="modal-success-text mb-8">Suas configurações de expediente e sinal foram atualizadas com êxito.</p>

            <button onclick="fecharModal()" class="btn-modal-ok">
                Entendido
            </button>
        </div>
    </div>

    <!-- JS Dark Mode original (preservado) -->
    <script src="../ScriptGlobal/darkModeConfiguracao.js"></script>
    <script src="../ScriptGlobal/logout.js"></script>

    <script>
        // ─── Modal de sucesso (lógica original preservada) ───
        const modal = document.getElementById('modalSucesso');
        const modalCard = document.getElementById('modalCard');

        function abrirModal() {
            modal.classList.remove('hidden');
            setTimeout(() => {
                modalCard.classList.remove('scale-90', 'opacity-0');
                modalCard.classList.add('scale-100', 'opacity-100');
            }, 10);
        }

        function fecharModal() {
            modalCard.classList.remove('scale-100', 'opacity-100');
            modalCard.classList.add('scale-90', 'opacity-0');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300);
        }

        // ─── NOVO: Lógica do seletor de dias da semana ───
        const diasSemanaInput = document.getElementById('dias_semana');
        const weekdayPills = document.querySelectorAll('.weekday-pill');

        function atualizarDiasSemanaHidden() {
            const selecionados = Array.from(weekdayPills)
                .filter(pill => pill.querySelector('input[type="checkbox"]').checked)
                .map(pill => pill.dataset.day);
            diasSemanaInput.value = selecionados.join(',');
        }

        function marcarDiasSemana(diasString) {
            const dias = (diasString || '1,2,3,4,5').split(',').map(d => d.trim()).filter(Boolean);
            weekdayPills.forEach(pill => {
                const checkbox = pill.querySelector('input[type="checkbox"]');
                const ativo = dias.includes(pill.dataset.day);
                checkbox.checked = ativo;
                pill.classList.toggle('active', ativo);
            });
            diasSemanaInput.value = dias.join(',');
        }

        weekdayPills.forEach(pill => {
            const checkbox = pill.querySelector('input[type="checkbox"]');
            pill.addEventListener('click', (e) => {
                e.preventDefault();
                checkbox.checked = !checkbox.checked;
                pill.classList.toggle('active', checkbox.checked);
                atualizarDiasSemanaHidden();
            });
        });

        // Estado padrão inicial: Segunda a Sexta (igual ao valor original do form)
        marcarDiasSemana('1,2,3,4,5');

        // ─── NOVO: Lógica de Recessos / Feriados Prolongados ───
        const periodosFechadosInput = document.getElementById('periodos_fechados');
        const recessoList = document.getElementById('recessoList');
        const recessoEmptyState = document.getElementById('recessoEmptyState');
        const recessoErrorMsg = document.getElementById('recessoErrorMsg');
        const btnAddRecesso = document.getElementById('btnAddRecesso');
        const inputRecessoTitulo = document.getElementById('recesso_titulo');
        const inputRecessoInicio = document.getElementById('recesso_inicio');
        const inputRecessoFim = document.getElementById('recesso_fim');

        let periodosFechados = []; // [{ id, titulo, inicio, fim }]

        function gerarIdRecesso() {
            return 'r_' + Date.now() + '_' + Math.floor(Math.random() * 1000);
        }

        function formatarDataBR(isoStr) {
            if (!isoStr) return '—';
            const [ano, mes, dia] = isoStr.split('-');
            return `${dia}/${mes}/${ano}`;
        }

        function calcularDias(inicioStr, fimStr) {
            const inicio = new Date(inicioStr + 'T00:00:00');
            const fim = new Date(fimStr + 'T00:00:00');
            const diff = Math.round((fim - inicio) / (1000 * 60 * 60 * 24)) + 1;
            return diff > 0 ? diff : 0;
        }

        function mostrarErroRecesso(msg) {
            recessoErrorMsg.querySelector('span').textContent = msg;
            recessoErrorMsg.style.display = 'flex';
            setTimeout(() => { recessoErrorMsg.style.display = 'none'; }, 4000);
        }

        function sincronizarPeriodosHidden() {
            periodosFechadosInput.value = JSON.stringify(periodosFechados);
        }

        function renderizarRecessos() {
            // Limpa lista atual (preservando o empty state como referência)
            recessoList.innerHTML = '';

            if (periodosFechados.length === 0) {
                recessoList.appendChild(recessoEmptyState);
                recessoEmptyState.style.display = 'block';
                return;
            }

            // Ordena por data de início
            const ordenados = [...periodosFechados].sort((a, b) => new Date(a.inicio) - new Date(b.inicio));

            ordenados.forEach(periodo => {
                const dias = calcularDias(periodo.inicio, periodo.fim);
                const item = document.createElement('div');
                item.className = 'recesso-item';
                item.dataset.id = periodo.id;
                item.innerHTML = `
                    <div class="recesso-icon"><i class="fas fa-umbrella-beach"></i></div>
                    <div class="recesso-info">
                        <div class="recesso-titulo">${periodo.titulo}</div>
                        <div class="recesso-periodo">
                            <span class="recesso-status-dot"></span>
                            ${formatarDataBR(periodo.inicio)} <i class="fas fa-arrow-right"></i> ${formatarDataBR(periodo.fim)}
                        </div>
                    </div>
                    <span class="recesso-dias-badge">${dias} ${dias === 1 ? 'dia' : 'dias'}</span>
                    <button type="button" class="btn-remove-recesso" data-id="${periodo.id}" title="Remover período">
                        <i class="fas fa-trash"></i>
                    </button>
                `;
                recessoList.appendChild(item);
            });

            // Liga os botões de remover recém-criados
            recessoList.querySelectorAll('.btn-remove-recesso').forEach(btn => {
                btn.addEventListener('click', () => removerRecesso(btn.dataset.id));
            });
        }

        function adicionarRecesso() {
            const titulo = inputRecessoTitulo.value.trim();
            const inicio = inputRecessoInicio.value;
            const fim = inputRecessoFim.value;

            if (!titulo) { mostrarErroRecesso('Informe um motivo ou descrição para o período.'); return; }
            if (!inicio || !fim) { mostrarErroRecesso('Selecione as datas de início e fim do período.'); return; }
            if (new Date(fim) < new Date(inicio)) { mostrarErroRecesso('A data de fim não pode ser anterior à data de início.'); return; }

            periodosFechados.push({
                id: gerarIdRecesso(),
                titulo,
                inicio,
                fim
            });

            sincronizarPeriodosHidden();
            renderizarRecessos();

            // Limpa o formulário de adição
            inputRecessoTitulo.value = '';
            inputRecessoInicio.value = '';
            inputRecessoFim.value = '';
            inputRecessoTitulo.focus();
        }

        function removerRecesso(id) {
            const item = recessoList.querySelector(`.recesso-item[data-id="${id}"]`);
            if (item) {
                item.classList.add('removing');
                setTimeout(() => {
                    periodosFechados = periodosFechados.filter(p => p.id !== id);
                    sincronizarPeriodosHidden();
                    renderizarRecessos();
                }, 280);
            } else {
                periodosFechados = periodosFechados.filter(p => p.id !== id);
                sincronizarPeriodosHidden();
                renderizarRecessos();
            }
        }

        function carregarPeriodosFechados(periodosString) {
            try {
                const dados = typeof periodosString === 'string' ? JSON.parse(periodosString) : periodosString;
                if (Array.isArray(dados)) {
                    periodosFechados = dados.map(p => ({
                        id: p.id || gerarIdRecesso(),
                        titulo: p.titulo || p.descricao || 'Período de Fechamento',
                        inicio: p.inicio || p.data_inicio,
                        fim: p.fim || p.data_fim
                    })).filter(p => p.inicio && p.fim);
                    sincronizarPeriodosHidden();
                    renderizarRecessos();
                }
            } catch (e) {
                console.error('Erro ao carregar períodos fechados:', e);
            }
        }

        btnAddRecesso.addEventListener('click', adicionarRecesso);

        // Permite adicionar pressionando Enter nos campos do recesso
        [inputRecessoTitulo, inputRecessoInicio, inputRecessoFim].forEach(input => {
            input.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') { e.preventDefault(); adicionarRecesso(); }
            });
        });

        // Render inicial (estado vazio)
        renderizarRecessos();

        // ─── Carregar configurações (lógica original preservada + dias_semana + recessos) ───
        async function carregarConfiguracoes() {
            try {
                const response = await fetch('/api/config/minha-configuracao', {
                    headers: { 'Authorization': `Bearer ${localStorage.getItem('token')}` }
                });
                if (response.ok) {
                    const data = await response.json();
                    if (data && !data.useDefault) {
                        document.getElementById('horario_abertura').value = data.horario_abertura || '';
                        document.getElementById('horario_fechamento').value = data.horario_fechamento || '';
                        document.getElementById('duracao_atendimento').value = data.duracao_atendimento || '30';
                        document.getElementById('valor_sinal').value = data.valor_sinal || '';
                        // NOVO: aplica os dias da semana retornados pelo backend, se existirem
                        if (data.dias_semana) {
                            marcarDiasSemana(data.dias_semana);
                        }
                        // NOVO: aplica os períodos de fechamento (recessos/feriados) retornados pelo backend
                        if (data.periodos_fechados) {
                            carregarPeriodosFechados(data.periodos_fechados);
                        }
                    }
                }
            } catch (error) { console.error('Erro ao carregar:', error); }
        }

        // ─── Submit (lógica original preservada, dias_semana e periodos_fechados agora dinâmicos) ───
        document.getElementById('formConfig').addEventListener('submit', async (e) => {
            e.preventDefault();

            atualizarDiasSemanaHidden();
            sincronizarPeriodosHidden();

            const formData = {
                horario_abertura: document.getElementById('horario_abertura').value,
                horario_fechamento: document.getElementById('horario_fechamento').value,
                duracao_atendimento: document.getElementById('duracao_atendimento').value,
                valor_sinal: document.getElementById('valor_sinal').value,
                dias_semana: document.getElementById('dias_semana').value || '1,2,3,4,5',
                periodos_fechados: document.getElementById('periodos_fechados').value || '[]'
            };

            try {
                const response = await fetch('/api/config/salvar-configuracao', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${localStorage.getItem('token')}`
                    },
                    body: JSON.stringify(formData)
                });

                const result = await response.json();

                if (response.ok && result.success) {
                    // Re-sincroniza com o servidor para confirmar que recessos removidos/adicionados persistiram
                    await carregarConfiguracoes();
                    abrirModal();
                } else {
                    alert('Erro ao salvar: ' + (result.message || result.error || 'Erro no servidor'));
                }
            } catch (error) {
                console.error('Erro:', error);
            }
        });

        window.onload = carregarConfiguracoes;
    </script>

    <!-- Mobile drawer + tabbar scroll hide -->
    <script>
        (function () {
            const btnOpen = document.getElementById('btnOpenDrawer');
            const btnClose = document.getElementById('btnCloseDrawer');
            const drawer = document.getElementById('mobileDrawer');
            const overlay = document.getElementById('drawerOverlay');

            function openDrawer() {
                if (!drawer) return;
                drawer.classList.add('open');
                if (overlay) overlay.classList.add('open');
                document.body.style.overflow = 'hidden';
            }
            function closeDrawer() {
                if (!drawer) return;
                drawer.classList.remove('open');
                if (overlay) overlay.classList.remove('open');
                document.body.style.overflow = '';
            }

            if (btnOpen) btnOpen.addEventListener('click', openDrawer);
            if (btnClose) btnClose.addEventListener('click', closeDrawer);
            if (overlay) overlay.addEventListener('click', closeDrawer);

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') closeDrawer();
            });

            // Tema mobile: reaproveita o botão desktop se existir
            const themeMobile = document.getElementById('theme-toggle-btn-mobile');
            const themeDesktop = document.getElementById('darkModeToggle');
            if (themeMobile && themeDesktop) {
                themeMobile.addEventListener('click', function () {
                    themeDesktop.click();
                });
            }
        })();

        // Tab bar some durante o scroll e volta quando parar
        (function () {
            const tabbar = document.querySelector('.mobile-bottom-tabbar');
            if (!tabbar) return;

            const scrollEl = document.querySelector('main');
            let scrollTimer = null;

            function esconderTabbar() {
                tabbar.classList.add('tabbar-hidden');
            }
            function mostrarTabbar() {
                tabbar.classList.remove('tabbar-hidden');
            }
            function aoRolar() {
                esconderTabbar();
                clearTimeout(scrollTimer);
                scrollTimer = setTimeout(mostrarTabbar, 300);
            }

            if (scrollEl) scrollEl.addEventListener('scroll', aoRolar, { passive: true });
            window.addEventListener('scroll', aoRolar, { passive: true });
        })();
    </script>

</body>
</html>