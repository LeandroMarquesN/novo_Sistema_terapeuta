        <div class="max-w-4xl mx-auto">
            <form id="formConfig" class="space-y-8">

                <!-- ─── Card de Horários ─── -->
                <div class="glass-card p-8">
                    <div class="card-center-head">
                        <div class="card-icon-wrap card-icon-cyan"><i class="fas fa-clock"></i></div>
                        <h2 class="card-title">Expediente</h2>
