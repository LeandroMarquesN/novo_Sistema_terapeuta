<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Configurações | MedLM</title>

    <!-- Segurança -->
    <script src="../ScriptGlobal/verifiLog.js"></script>
    <script src="../ScriptGlobal/BloqBotVoltar.js"></script>

    <!-- Tailwind e Fontes -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="icon" href="../logo/faviicon.png" type="image/x-icon">

    <!-- CSS Dark Mode original (mantido, agora redundante visualmente mas preservado) -->
    <link rel="stylesheet" href="../css/darkModeConfiguracao.css">

    <style>
        /* ─── Design Tokens ─── */
        :root {
            --emerald:   #34d399;
            --emerald-d: #059669;
            --cyan:      #22d3ee;
            --amber:     #fbbf24;
            --red:       #f87171;
            --slate-bg:  #020c12;
            --border:    rgba(52,211,153,0.15);
            --border-cy: rgba(34,211,238,0.18);
            --card:      rgba(255,255,255,0.028);
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--slate-bg);
            background-image:
                radial-gradient(ellipse 75% 60% at 10% 0%,   rgba(8,145,178,0.22) 0%, transparent 65%),
                radial-gradient(ellipse 60% 55% at 90% 100%, rgba(5,150,105,0.20) 0%, transparent 65%),
                radial-gradient(ellipse 45% 40% at 50% 45%,  rgba(251,191,36,0.04) 0%, transparent 70%);
            color: #cbd5e1;
            min-height: 100vh;
            overflow-x: hidden;
            transition: background 0.3s ease;
        }

        /* Scanlines */
        body::before {
            content: '';
            position: fixed; inset: 0;
            background: repeating-linear-gradient(
                0deg, transparent, transparent 2px,
                rgba(0,0,0,0.06) 2px, rgba(0,0,0,0.06) 4px
            );
            pointer-events: none; z-index: 0;
        }

        /* Orbs */
        .orb {
            position: fixed; border-radius: 50%;
            pointer-events: none; filter: blur(80px); z-index: 0;
        }
        .orb-1 {
            width: 500px; height: 500px;
            background: radial-gradient(circle, rgba(8,145,178,0.18), transparent 70%);
            top: -14%; left: -10%;
            animation: orbFloat1 14s ease-in-out infinite;
        }
        .orb-2 {
            width: 420px; height: 420px;
            background: radial-gradient(circle, rgba(5,150,105,0.15), transparent 70%);
            bottom: -10%; right: -8%;
            animation: orbFloat2 18s ease-in-out infinite;
        }
        .orb-3 {
            width: 260px; height: 260px;
            background: radial-gradient(circle, rgba(251,191,36,0.05), transparent 70%);
            top: 45%; left: 45%;
            animation: orbFloat1 22s ease-in-out infinite reverse;
        }
        @keyframes orbFloat1 { 0%,100%{transform:translate(0,0)} 50%{transform:translate(28px,20px)} }
        @keyframes orbFloat2 { 0%,100%{transform:translate(0,0)} 50%{transform:translate(-20px,-28px)} }

        /* Grid lines */
        .hero-grid {
            position: fixed; inset: 0; z-index: 0;
            background-image:
                linear-gradient(rgba(52,211,153,0.035) 1px, transparent 1px),
                linear-gradient(90deg, rgba(52,211,153,0.035) 1px, transparent 1px);
            background-size: 60px 60px;
            mask-image: radial-gradient(ellipse 85% 80% at 50% 50%, black 20%, transparent 100%);
        }

        /* Scrollbar */
        ::-webkit-scrollbar { width: 4px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: rgba(52,211,153,0.3); border-radius: 99px; }

        main { position: relative; z-index: 1; }

        /* ─── Header ─── */
        .page-title {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 30px; font-weight: 800;
            background: linear-gradient(90deg, var(--cyan), var(--emerald));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            background-clip: text;
            filter: drop-shadow(0 0 8px rgba(34,211,238,0.25));
        }
        .page-sub { color: rgba(148,163,184,0.5); font-size: 13px; margin-top: 6px; }

        /* Header buttons */
        .icon-btn {
            width: 48px; height: 48px; border-radius: 16px;
            background: rgba(255,255,255,0.03);
            border: 1px solid var(--border);
            backdrop-filter: blur(10px);
            display: flex; align-items: center; justify-content: center;
            color: rgba(148,163,184,0.6);
            transition: all 0.25s; text-decoration: none; cursor: pointer;
        }
        .icon-btn:hover {
            transform: scale(1.08);
            color: var(--emerald);
            border-color: rgba(52,211,153,0.3);
            box-shadow: 0 0 16px rgba(52,211,153,0.15);
        }
        #darkModeToggle:hover { color: var(--amber); border-color: rgba(251,191,36,0.3); box-shadow: 0 0 16px rgba(251,191,36,0.15); }

        /* ─── Glass card ─── */
        .glass-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 28px;
            position: relative;
            overflow: hidden;
        }
        .glass-card::before {
            content: '';
            position: absolute; top: 0; left: 0; right: 0; height: 1px;
            background: linear-gradient(90deg, transparent, var(--emerald), var(--cyan), transparent);
            opacity: 0.4;
        }

        /* Card header icon */
        .card-icon-wrap {
            width: 42px; height: 42px; border-radius: 13px;
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0;
        }
        .card-icon-cyan { background: rgba(34,211,238,0.1); border: 1px solid rgba(34,211,238,0.25); }
        .card-icon-cyan i { color: var(--cyan); }
        .card-icon-emerald { background: rgba(52,211,153,0.1); border: 1px solid rgba(52,211,153,0.25); }
        .card-icon-emerald i { color: var(--emerald); }
        .card-icon-amber { background: rgba(251,191,36,0.1); border: 1px solid rgba(251,191,36,0.25); }
        .card-icon-amber i { color: var(--amber); }

        .card-title {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 19px; font-weight: 800; color: #f1f5f9;
        }

        /* ─── Inputs ─── */
        .form-label {
            display: block;
            font-size: 10px; font-weight: 800;
            color: rgba(148,163,184,0.45);
            text-transform: uppercase; letter-spacing: 0.12em;
            margin-bottom: 8px;
        }
        .input-premium {
            background: rgba(255,255,255,0.04) !important;
            border: 1px solid var(--border) !important;
            border-radius: 16px !important;
            color: #e2e8f0 !important;
            font-family: 'Inter', sans-serif;
            transition: all 0.25s;
            outline: none;
            -webkit-appearance: none;
        }
        .input-premium:focus {
            border-color: rgba(52,211,153,0.4) !important;
            box-shadow: 0 0 0 4px rgba(52,211,153,0.08) !important;
        }
        .input-premium::placeholder { color: rgba(148,163,184,0.22) !important; }
        select.input-premium option { background: #0d1f2d; color: #e2e8f0; }

        /* color-scheme so native time/date pickers render light icons on dark bg */
        input[type="time"], input[type="date"] { color-scheme: dark; }

        /* ─── Weekday selector (NEW) ─── */
        .weekday-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 10px;
            max-width: 560px;
            margin: 0 auto;
        }
        @media (max-width: 640px) {
            .weekday-grid { grid-template-columns: repeat(4, 1fr); }
        }

        .weekday-pill {
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            gap: 4px;
            padding: 14px 4px;
            background: rgba(255,255,255,0.03);
            border: 1px solid var(--border);
            border-radius: 16px;
            cursor: pointer;
            transition: all 0.25s;
            user-select: none;
            position: relative;
        }
        .weekday-pill:hover { border-color: rgba(52,211,153,0.3); background: rgba(52,211,153,0.05); transform: translateY(-2px); }

        .weekday-pill input[type="checkbox"] {
            position: absolute; opacity: 0; width: 0; height: 0;
        }

        .weekday-pill .wd-letter {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 13px; font-weight: 800;
            color: rgba(148,163,184,0.6);
            transition: color 0.25s;
        }
        .weekday-pill .wd-label {
            font-size: 9px; font-weight: 700;
            color: rgba(148,163,184,0.35);
            text-transform: uppercase; letter-spacing: 0.06em;
        }

        .weekday-pill.active {
            background: linear-gradient(135deg, rgba(8,145,178,0.28), rgba(5,150,105,0.22));
            border-color: rgba(52,211,153,0.45);
            box-shadow: 0 0 16px rgba(52,211,153,0.18);
        }
        .weekday-pill.active .wd-letter { color: var(--emerald); text-shadow: 0 0 10px rgba(52,211,153,0.5); }
        .weekday-pill.active .wd-label  { color: rgba(52,211,153,0.7); }

        .weekday-hint {
            font-size: 11px; color: rgba(148,163,184,0.4);
            margin-top: 16px; display: flex; align-items: center; justify-content: center; gap: 6px;
            text-align: center;
        }
        .weekday-hint i { color: var(--cyan); font-size: 10px; }

        /* ─── Centering helpers for cards ─── */
        .card-center-head {
            display: flex; flex-direction: column; align-items: center;
            text-align: center; margin-bottom: 28px;
        }
        .card-center-head .card-icon-wrap { margin-bottom: 10px; }
        .card-desc { font-size: 12px; color: rgba(148,163,184,0.4); margin-top: 4px; max-width: 420px; }

        /* ─── Recesso / Feriados Section (NEW) ─── */
        .recesso-form-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr) repeat(2, 1fr) auto;
            gap: 14px;
            align-items: end;
            max-width: 760px;
            margin: 0 auto;
        }
        @media (max-width: 900px) {
            .recesso-form-grid { grid-template-columns: 1fr 1fr; }
            .recesso-form-grid .recesso-span-full { grid-column: span 2; }
        }
        @media (max-width: 560px) {
            .recesso-form-grid { grid-template-columns: 1fr; }
            .recesso-form-grid .recesso-span-full { grid-column: span 1; }
        }

        .btn-add-recesso {
            display: inline-flex; align-items: center; justify-content: center; gap: 8px;
            background: linear-gradient(135deg, rgba(251,191,36,0.22), rgba(217,119,6,0.18));
            border: 1px solid rgba(251,191,36,0.35);
            color: var(--amber);
            font-weight: 800; font-size: 13px;
            padding: 13px 20px; border-radius: 14px;
            cursor: pointer; transition: all 0.25s;
            font-family: 'Space Grotesk', sans-serif;
            white-space: nowrap;
            height: 52px;
        }
        .btn-add-recesso:hover {
            background: linear-gradient(135deg, rgba(251,191,36,0.32), rgba(217,119,6,0.26));
            box-shadow: 0 0 18px rgba(251,191,36,0.25);
            transform: translateY(-2px);
        }
        .btn-add-recesso:active { transform: translateY(0) scale(0.97); }

        /* Recesso list */
        .recesso-list {
            margin-top: 26px;
            display: flex; flex-direction: column; gap: 10px;
            max-width: 760px;
            margin-left: auto; margin-right: auto;
        }

        .recesso-empty {
            text-align: center;
            padding: 28px 16px;
            color: rgba(148,163,184,0.35);
            font-size: 13px;
            border: 1px dashed var(--border);
            border-radius: 16px;
            background: rgba(255,255,255,0.015);
        }
        .recesso-empty i { display: block; font-size: 22px; margin-bottom: 8px; color: rgba(251,191,36,0.3); }

        .recesso-item {
            display: flex; align-items: center; gap: 14px;
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(251,191,36,0.18);
            border-radius: 16px;
            padding: 14px 18px;
            position: relative;
            overflow: hidden;
            animation: slideInFade 0.4s cubic-bezier(0.4,0,0.2,1);
            transition: all 0.25s;
        }
        .recesso-item::before {
            content: '';
            position: absolute; top: 0; left: 0; bottom: 0; width: 3px;
            background: linear-gradient(180deg, var(--amber), #d97706);
        }
        .recesso-item:hover {
            border-color: rgba(251,191,36,0.35);
            box-shadow: 0 4px 20px rgba(251,191,36,0.08);
            transform: translateX(2px);
        }
        .recesso-item.removing {
            animation: slideOutFade 0.3s ease forwards;
        }

        @keyframes slideInFade {
            from { opacity: 0; transform: translateY(-8px) scale(0.98); }
            to   { opacity: 1; transform: translateY(0) scale(1); }
        }
        @keyframes slideOutFade {
            to { opacity: 0; transform: translateX(30px) scale(0.95); height: 0; padding: 0; margin: 0; border: none; }
        }

        .recesso-icon {
            width: 38px; height: 38px; border-radius: 11px;
            background: rgba(251,191,36,0.12);
            border: 1px solid rgba(251,191,36,0.25);
            color: var(--amber);
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0; font-size: 14px;
        }

        .recesso-info { flex: 1; min-width: 0; }
        .recesso-titulo {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 14px; font-weight: 700; color: #f1f5f9;
            margin-bottom: 2px;
        }
        .recesso-periodo {
            font-size: 11px; color: rgba(251,191,36,0.65);
            font-weight: 600;
            display: flex; align-items: center; gap: 6px;
        }
        .recesso-periodo i { font-size: 9px; }
        .recesso-dias-badge {
            font-size: 9px; font-weight: 800;
            background: rgba(251,191,36,0.1);
            border: 1px solid rgba(251,191,36,0.22);
            color: var(--amber);
            padding: 2px 8px; border-radius: 99px;
            white-space: nowrap;
        }

        .btn-remove-recesso {
            width: 34px; height: 34px; border-radius: 10px;
            background: rgba(248,113,113,0.08);
            border: 1px solid rgba(248,113,113,0.2);
            color: var(--red);
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; transition: all 0.22s;
            flex-shrink: 0; font-size: 12px;
        }
        .btn-remove-recesso:hover {
            background: rgba(248,113,113,0.18);
            box-shadow: 0 0 12px rgba(248,113,113,0.2);
            transform: scale(1.08);
        }

        /* Pulsing badge for active/upcoming recess */
        .recesso-status-dot {
            width: 6px; height: 6px; border-radius: 50%;
            background: var(--amber);
            box-shadow: 0 0 6px var(--amber);
            animation: pulse 2s infinite;
            display: inline-block;
        }
        @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.35; } }

        /* ─── Submit button ─── */
        .btn-save {
            display: inline-flex; align-items: center; gap: 10px;
            background: linear-gradient(135deg, #0891b2 0%, #059669 100%);
            color: #fff; font-weight: 800; font-size: 15px;
            padding: 17px 40px; border-radius: 18px;
            border: 1px solid rgba(52,211,153,0.3);
            cursor: pointer; transition: all 0.3s;
            font-family: 'Space Grotesk', sans-serif;
            box-shadow: 0 0 28px rgba(8,145,178,0.35);
            position: relative; overflow: hidden;
        }
        .btn-save::before {
            content: '';
            position: absolute; top: 0; left: -100%; width: 60%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.12), transparent);
            transform: skewX(-20deg); transition: left 0.6s ease;
        }
        .btn-save:hover { transform: translateY(-2px); box-shadow: 0 0 40px rgba(8,145,178,0.55); }
        .btn-save:hover::before { left: 150%; }

        /* ─── Modal sucesso ─── */
        #modalSucesso .glass-card {
            background: rgba(2,12,18,0.97);
            border: 1px solid rgba(52,211,153,0.25);
            box-shadow: 0 0 60px rgba(52,211,153,0.1);
        }
        .modal-success-icon {
            width: 76px; height: 76px;
            background: rgba(52,211,153,0.1);
            border: 1px solid rgba(52,211,153,0.3);
            color: var(--emerald);
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 22px; font-size: 30px;
            box-shadow: 0 0 24px rgba(52,211,153,0.2);
        }
        .modal-success-title {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 22px; font-weight: 800; color: #f1f5f9;
        }
        .modal-success-text { color: rgba(148,163,184,0.55); font-size: 13px; }
        .btn-modal-ok {
            width: 100%;
            background: linear-gradient(135deg, #059669, #34d399);
            color: #020c12; font-weight: 800;
            padding: 15px; border-radius: 16px;
            border: none; cursor: pointer; transition: all 0.25s;
            font-family: 'Space Grotesk', sans-serif;
            box-shadow: 0 0 20px rgba(52,211,153,0.25);
        }
        .btn-modal-ok:hover { box-shadow: 0 0 30px rgba(52,211,153,0.4); transform: translateY(-1px); }

        /* ─── Mobile nav (topbar + drawer + tabbar) – igual ao dashboard ─── */
        .mobile-topbar,
        .mobile-bottom-tabbar,
        .mobile-drawer-overlay,
        .mobile-drawer {
            display: none;
        }

        @media (max-width: 1023px) {
            .mobile-topbar,
            .mobile-bottom-tabbar {
                display: flex !important;
            }

            main {
                padding-top: 88px !important;
                padding-bottom: 120px !important;
            }

            /* esconde botões do header desktop no mobile (já tem topbar) */
            .mb-10.flex.justify-between .flex.items-center.gap-3 {
                display: none !important;
            }

            .mobile-topbar {
                position: fixed;
                top: 0; left: 0; right: 0;
                z-index: 60;
                height: 64px;
                background: rgba(2, 12, 18, 0.95);
                border-bottom: 1px solid rgba(52, 211, 153, 0.15);
                backdrop-filter: blur(20px);
                -webkit-backdrop-filter: blur(20px);
                align-items: center;
                justify-content: space-between;
                padding: 0 16px;
            }
            .mobile-topbar .logo-wrap {
                display: flex;
                align-items: center;
                gap: 10px;
            }
            .mobile-topbar .logo-icon {
                width: 38px; height: 38px;
                border-radius: 12px;
                background: linear-gradient(135deg, #0891b2 0%, #059669 100%);
                box-shadow: 0 0 16px rgba(8,145,178,0.4);
                display: flex; align-items: center; justify-content: center;
                color: #fff; font-weight: 800; font-size: 15px;
                font-family: 'Space Grotesk', sans-serif;
            }
            .mobile-topbar .logo-text {
                font-family: 'Space Grotesk', sans-serif;
                font-weight: 800; font-size: 18px; color: #e2e8f0;
            }
            .mobile-topbar .logo-text span {
                color: #34d399;
                text-shadow: 0 0 10px rgba(52,211,153,0.5);
            }
            .mobile-topbar .actions {
                display: flex; align-items: center; gap: 8px;
            }
            .mobile-topbar .icon-btn {
                width: 40px; height: 40px; border-radius: 12px;
                background: rgba(255,255,255,0.04);
                border: 1px solid rgba(52,211,153,0.15);
                color: rgba(148,163,184,0.7);
                display: flex; align-items: center; justify-content: center;
                cursor: pointer; transition: all 0.2s;
                text-decoration: none;
            }
            .mobile-topbar .icon-btn:active {
                color: #34d399;
                transform: scale(0.94);
            }

            .mobile-drawer-overlay {
                display: block;
                position: fixed; inset: 0;
                background: rgba(2,12,18,0.7);
                backdrop-filter: blur(6px);
                z-index: 70;
                opacity: 0; pointer-events: none;
                transition: opacity 0.3s;
            }
            .mobile-drawer-overlay.open {
                opacity: 1; pointer-events: auto;
            }
            .mobile-drawer {
                display: flex;
                flex-direction: column;
                position: fixed;
                top: 0; left: 0; bottom: 0;
                width: min(300px, 85vw);
                background: rgba(4, 16, 24, 0.98);
                border-right: 1px solid rgba(52,211,153,0.18);
                z-index: 80;
                transform: translateX(-105%);
                transition: transform 0.3s cubic-bezier(0.4,0,0.2,1);
                padding: 0;
            }
            .mobile-drawer.open {
                transform: translateX(0);
            }
            .mobile-drawer .drawer-header {
                display: flex; align-items: center; justify-content: space-between;
                padding: 20px 18px;
                border-bottom: 1px solid rgba(52,211,153,0.12);
            }
            .mobile-drawer .drawer-logo {
                display: flex; align-items: center; gap: 12px;
            }
            .mobile-drawer .drawer-logo .logo-icon {
                width: 42px; height: 42px; border-radius: 12px;
                background: linear-gradient(135deg, #0891b2, #059669);
                display: flex; align-items: center; justify-content: center;
                color: #fff; font-weight: 800; font-size: 16px;
            }
            .mobile-drawer .drawer-logo span {
                font-family: 'Space Grotesk', sans-serif;
                font-weight: 700; font-size: 18px; color: #e2e8f0;
            }
            .mobile-drawer .drawer-logo span b { color: #34d399; }
            .mobile-drawer .close-drawer {
                width: 36px; height: 36px; border-radius: 10px;
                background: rgba(255,255,255,0.04);
                border: 1px solid rgba(255,255,255,0.08);
                color: rgba(148,163,184,0.7);
                display: flex; align-items: center; justify-content: center;
                cursor: pointer;
            }
            .mobile-drawer nav {
                flex: 1; padding: 16px 12px;
                display: flex; flex-direction: column; gap: 4px;
                overflow-y: auto;
            }
            .mobile-drawer .nav-item {
                display: flex; align-items: center; gap: 14px;
                padding: 14px 16px; border-radius: 14px;
                color: rgba(148,163,184,0.7);
                font-weight: 600; font-size: 14px;
                text-decoration: none;
                transition: all 0.2s;
