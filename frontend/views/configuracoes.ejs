                    <div class="weekday-grid" id="weekdayGrid">
                        <label class="weekday-pill" data-day="0">
                            <input type="checkbox" name="dias_semana_check" value="0">
                            <span class="wd-letter">D</span>
                            <span class="wd-label">Dom</span>
                        </label>
                        <label class="weekday-pill" data-day="1">
                            <input type="checkbox" name="dias_semana_check" value="1">
                            <span class="wd-letter">S</span>
                            <span class="wd-label">Seg</span>
                        </label>
                        <label class="weekday-pill" data-day="2">
                            <input type="checkbox" name="dias_semana_check" value="2">
                            <span class="wd-letter">T</span>
                            <span class="wd-label">Ter</span>
                        </label>
                        <label class="weekday-pill" data-day="3">
                            <input type="checkbox" name="dias_semana_check" value="3">
                            <span class="wd-letter">Q</span>
                            <span class="wd-label">Qua</span>
                        </label>
                        <label class="weekday-pill" data-day="4">
                            <input type="checkbox" name="dias_semana_check" value="4">
                            <span class="wd-letter">Q</span>
                            <span class="wd-label">Qui</span>
                        </label>
                        <label class="weekday-pill" data-day="5">
                            <input type="checkbox" name="dias_semana_check" value="5">
                            <span class="wd-letter">S</span>
                            <span class="wd-label">Sex</span>
                        </label>
                        <label class="weekday-pill" data-day="6">
                            <input type="checkbox" name="dias_semana_check" value="6">
                            <span class="wd-letter">S</span>
                            <span class="wd-label">Sáb</span>
                        </label>
                    </div>

                    <p class="weekday-hint">
                        <i class="fas fa-info-circle"></i>
                        Selecione os dias em que sua clínica realiza atendimentos. Padrão: Segunda a Sexta.
