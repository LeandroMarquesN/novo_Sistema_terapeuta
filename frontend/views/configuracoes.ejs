                    <p id="recessoErrorMsg" class="weekday-hint" style="display:none;color:#f87171">
                        <i class="fas fa-exclamation-circle" style="color:#f87171"></i>
                        <span></span>
                    </p>

                    <!-- Lista dinâmica de recessos cadastrados -->
                    <div class="recesso-list" id="recessoList">
                        <div class="recesso-empty" id="recessoEmptyState">
                            <i class="fas fa-calendar-check"></i>
                            Nenhum período de fechamento cadastrado.<br>Adicione acima um recesso ou feriado prolongado.
                        </div>
                    </div>

                    <!-- Campo oculto enviado junto ao formulário principal -->
                    <input type="hidden" id="periodos_fechados" name="periodos_fechados" value="[]">
                </div>

                <!-- ─── Card de Pagamento ─── -->
                <div class="glass-card p-8">
                    <div class="card-center-head">
                        <div class="card-icon-wrap card-icon-amber"><i class="fas fa-wallet"></i></div>
                        <h2 class="card-title">Taxa de Sinal</h2>
                        <p class="card-desc">Valor cobrado como confirmação antecipada do agendamento.</p>
                    </div>
                    <div class="max-w-xs mx-auto">
                        <label class="form-label text-center" style="text-align:center">Valor PIX (R$)</label>
                        <input type="number" step="0.01" name="valor_sinal" id="valor_sinal" class="input-premium w-full p-4 font-bold text-xl text-center">
                    </div>
