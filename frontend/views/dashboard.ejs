<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8">
    <title>Terapeuta Pro - Dashboard</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link href="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.3.0/flowbite.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://unpkg.com/tippy.js@6/dist/tippy.css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="../ScriptGlobal/verifiLog.js"></script>

    <script>
      tailwind.config = {
          darkMode: 'class',
          theme: {
              extend: {
                  fontFamily: {
                      sans: ['Poppins', 'sans-serif'],
                  },
                  animation: {
                      'gradient-x': 'gradient-x 15s ease infinite',
                      'gradient-y': 'gradient-y 15s ease infinite',
                      'gradient-xy': 'gradient-xy 15s ease infinite',
                  },
                  keyframes: {
                      'gradient-x': {
                          '0%, 100%': { 'background-size': '200% 200%', 'background-position': 'left center' },
                          '50%': { 'background-size': '200% 200%', 'background-position': 'right center' }
                      },
                      'gradient-y': {
                          '0%, 100%': { 'background-size': '200% 200%', 'background-position': 'center top' },
                          '50%': { 'background-size': '200% 200%', 'background-position': 'center bottom' }
                      },
                      'gradient-xy': {
                          '0%, 100%': { 'background-size': '400% 400%', 'background-position': 'left center' },
                          '50%': { 'background-size': '400% 400%', 'background-position': 'right center' }
                      }
                  }
              }
          }
      }
    </script>

    <style>
        /* ---- Logo Hover Effect ---- */
        .h-24 div.bg-gradient-to-br {
            position: relative;
            overflow: hidden;
            transition: transform 0.3s ease;
        }
        .h-24:hover div.bg-gradient-to-br {
            transform: scale(1.1) rotate(-5deg);
        }
        .h-24 div.bg-gradient-to-br::after {
            content: "";
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(
                to right,
                rgba(255, 255, 255, 0) 0%,
                rgba(255, 255, 255, 0.3) 50%,
                rgba(255, 255, 255, 0) 100%
            );
            transform: skewX(-25deg);
        }
        .h-24:hover div.bg-gradient-to-br::after {
            left: 100%;
            transition: all 0.6s ease;
        }

        /* ---- Background Mesh Gradient ---- */
        .bg-mesh-gradient {
            background-size: 400% 400% !important;
            background-color: #70c2f9;
            background-image:
                radial-gradient(at 10% 10%, rgba(56, 189, 248, 0.15) 0px, transparent 50%),
                radial-gradient(at 90% 10%, rgba(16, 185, 129, 0.1) 0px, transparent 50%),
                radial-gradient(at 50% 50%, rgba(240, 249, 255, 0.5) 0px, transparent 50%),
                radial-gradient(at 10% 90%, rgba(110, 231, 183, 0.15) 0px, transparent 50%),
                radial-gradient(at 90% 90%, rgba(14, 165, 233, 0.1) 0px, transparent 50%);
        }
        .dark .bg-mesh-gradient {
            background-size: 400% 400%;
            background-color: #030712;
            background-image:
                radial-gradient(at 10% 10%, rgba(14, 165, 233, 0.15) 0px, transparent 50%),
                radial-gradient(at 90% 10%, rgba(5, 150, 105, 0.1) 0px, transparent 50%),
                radial-gradient(at 50% 50%, rgba(3, 7, 18, 0.5) 0px, transparent 50%),
                radial-gradient(at 10% 90%, rgba(16, 185, 129, 0.15) 0px, transparent 50%),
                radial-gradient(at 90% 90%, rgba(56, 189, 248, 0.1) 0px, transparent 50%);
        }

        /* ---- Smooth Card Hover ---- */
        .card-hover-effect {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            cursor: pointer;
        }
        .card-hover-effect:hover {
            transform: translateY(-6px);
        }
    </style>

    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/locales-all.min.js"></script>
    <script src="https://unpkg.com/@popperjs/core@2"></script>
    <script src="https://unpkg.com/tippy.js@6"></script>
</head>
<body class="bg-mesh-gradient animate-gradient-xy text-gray-800 dark:text-gray-100 min-h-screen font-sans antialiased">
    <div class="flex h-screen overflow-hidden">

        <aside class="fixed top-0 left-0 z-50 w-20 hover:w-64 transition-all duration-300 h-screen bg-white dark:bg-gray-900 border-r border-gray-100 dark:border-gray-800 overflow-hidden group shadow-sm flex flex-col justify-between">
            <div class="flex flex-col">
                <div class="h-24 flex items-center px-6 border-b dark:border-gray-800 overflow-hidden">
                    <div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-emerald-400 rounded-xl flex-shrink-0 shadow-lg flex items-center justify-center text-white font-bold text-lg">
                        M
                    </div>
                    <span class="ml-4 font-bold text-xl text-gray-800 dark:text-white opacity-0 group-hover:opacity-100 transition-all duration-300 whitespace-nowrap tracking-tight">
                        Med<span class="text-emerald-500 font-extrabold">LM</span>
                    </span>
                </div>

                <nav class="px-3 pt-6 space-y-2">
                    <a href="/dashboard" class="flex items-center p-3.5 rounded-2xl bg-gradient-to-r from-blue-500 to-emerald-400 text-white shadow-lg">
                        <i class="fas fa-chart-line w-6 text-lg"></i>
                        <span class="ml-4 font-semibold opacity-0 group-hover:opacity-100 whitespace-nowrap">Dashboard</span>
                    </a>
                    <a href="/pacientes" class="flex items-center p-3.5 rounded-2xl text-gray-500 hover:bg-gray-50 dark:hover:bg-gray-800 hover:text-blue-600 transition group/item">
                        <i class="fas fa-user-injured w-6 group-hover/item:text-blue-500"></i>
                        <span class="ml-4 font-medium opacity-0 group-hover:opacity-100 whitespace-nowrap">Pacientes</span>
                    </a>
                    <a href="/financeiro" class="flex items-center p-3.5 rounded-2xl text-gray-500 hover:bg-gray-50 dark:hover:bg-gray-800 hover:text-emerald-600 transition group/item">
                        <i class="fas fa-hand-holding-usd w-6 group-hover/item:text-emerald-500"></i>
                        <span class="ml-4 font-medium opacity-0 group-hover:opacity-100 whitespace-nowrap">Financeiro</span>
                    </a>
                    <a href="/agendamento" class="flex items-center p-3.5 rounded-2xl text-gray-500 hover:bg-gray-50 dark:hover:bg-gray-800 hover:text-emerald-600 transition group/item">
                        <i class="fas fa-calendar-check w-6 group-hover/item:text-emerald-500"></i>
                        <span class="ml-4 font-medium opacity-0 group-hover:opacity-100 whitespace-nowrap">Agendamento</span>
                    </a>

                    <a href="/atendimento" class="flex items-center p-3.5 rounded-2xl text-gray-500 hover:bg-gray-50 dark:hover:bg-gray-800 hover:text-blue-600 transition group/item">
                        <i class="fas fa-user-md w-6 group-hover/item:text-blue-500"></i>
                        <span class="ml-4 font-medium opacity-0 group-hover:opacity-100 whitespace-nowrap">Atendimento</span>
                    </a>

                    <a href="/equipe" class="flex items-center p-3.5 rounded-2xl text-gray-500 hover:bg-gray-50 dark:hover:bg-gray-800 hover:text-emerald-600 transition group/item">
                        <i class="fas fa-users-cog w-6 group-hover/item:text-emerald-500"></i>
                        <span class="ml-4 font-medium opacity-0 group-hover:opacity-100 whitespace-nowrap">Minha Equipe</span>
                    </a>
                    <a href="/dashboard/configuracoes" class="flex items-center p-3.5 rounded-2xl text-gray-500 hover:bg-gray-50 dark:hover:bg-gray-800 hover:text-emerald-600 transition group/item">
                        <i class="fas fa-cogs w-6 group-hover/item:text-emerald-500"></i>
                        <span class="ml-4 font-medium opacity-0 group-hover:opacity-100 whitespace-nowrap">Configurações</span>
                    </a>
                    <a href="#" onclick="handleLogout()" class="flex items-center p-3.5 rounded-2xl text-gray-500 hover:bg-red-50 dark:hover:bg-red-900/20 hover:text-red-600 transition group/item">
                        <i class="fas fa-sign-out-alt w-6 group-hover/item:text-red-500"></i>
                        <span class="ml-4 font-medium opacity-0 group-hover:opacity-100 whitespace-nowrap">Sair</span>
                    </a>
                </nav>
            </div>

            <div class="p-4 border-t dark:border-gray-800">
                <button id="theme-toggle-btn" class="flex items-center w-full p-3 rounded-2xl text-gray-500 hover:bg-gray-50 dark:hover:bg-gray-800 transition">
                    <i class="fas fa-moon w-6"></i>
                    <span class="ml-4 opacity-0 group-hover:opacity-100 font-medium">Tema</span>
                </button>
            </div>
        </aside>

        <main class="flex-1 ml-20 p-6 xl:p-10 overflow-y-auto h-screen">

            <header class="flex flex-col md:flex-row justify-between items-start md:items-center mb-10 pb-6 border-b border-gray-100 dark:border-gray-800 gap-4">
                <div>
                    <h1 id="boasVindas" class="text-3xl xl:text-4xl font-extrabold text-gray-950 dark:text-white tracking-tighter">
                        Olá, <span id="usuarioNome">Professor</span>
                        <span class="text-xl font-normal text-gray-400 dark:text-gray-500 mx-2">|</span>
                        <span id="clinicaNome" class="text-xl xl:text-2xl font-bold bg-gradient-to-r from-blue-600 to-emerald-500 bg-clip-text text-transparent">Espaço Saúde</span>
                    </h1>
                    <p class="text-gray-500 mt-1 text-sm xl:text-base">Resumo estratégico e métricas do seu consultório.</p>
                </div>

                <div class="flex items-center flex-wrap gap-4">
                    <div id="data-hora-container-tailwind" class="hidden md:flex bg-white dark:bg-gray-900 shadow-sm border border-gray-100 dark:border-gray-800 px-5 py-2.5 rounded-full text-xs xl:text-sm font-semibold text-gray-700 dark:text-gray-300">
                        <i class="fas fa-calendar-alt mr-3 text-emerald-500"></i>
                        <span id="data-hora"></span>
                    </div>

                    <a href="/agendamento" class="flex items-center bg-gradient-to-r from-orange-400 to-amber-400 text-white font-bold px-5 py-2.5 rounded-full shadow-lg shadow-orange-100 dark:shadow-none hover:scale-105 transition-transform text-xs xl:text-sm">
                        <i class="fas fa-plus mr-2"></i> Novo Agendamento
                    </a>

                    <div class="w-12 h-12 bg-white dark:bg-gray-800 rounded-full flex items-center justify-center text-blue-600 dark:text-blue-400 font-black shadow-md border border-gray-100 dark:border-gray-700 text-xs tracking-tighter">
                        MedLM
                    </div>
                </div>
            </header>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
                <div class="bg-gradient-to-br from-blue-50 to-white dark:from-gray-900 dark:to-gray-900 p-6 rounded-[2rem] shadow-sm border border-blue-100 dark:border-gray-800/80 card-hover-effect">
                    <div class="flex justify-between items-center">
                        <p class="text-gray-500 text-xs font-semibold uppercase tracking-wider">Atendimentos Dia</p>
                        <i class="fas fa-user-check text-blue-400 text-base"></i>
                    </div>
                    <h3 class="text-4xl font-extrabold mt-2 dark:text-white tracking-tight">12</h3>
                    <div class="mt-2 text-green-600 text-xs font-bold flex items-center gap-1"><i class="fas fa-arrow-up"></i> +20%</div>
                </div>
                <div class="bg-gradient-to-br from-red-50 to-white dark:from-gray-900 dark:to-gray-900 p-6 rounded-[2rem] shadow-sm border border-red-100 dark:border-gray-800/80 card-hover-effect">
                    <div class="flex justify-between items-center">
                        <p class="text-gray-500 text-xs font-semibold uppercase tracking-wider">Cancelamentos</p>
                        <i class="fas fa-user-times text-red-400 text-base"></i>
                    </div>
                    <h3 class="text-4xl font-extrabold mt-2 dark:text-white tracking-tight">2</h3>
                    <span class="text-red-500 text-xs font-bold block mt-1">Taxa de 4.1%</span>
                </div>
                <div class="bg-gradient-to-br from-orange-50 to-white dark:from-gray-900 dark:to-gray-900 p-6 rounded-[2rem] shadow-sm border border-orange-100 dark:border-gray-800/80 card-hover-effect">
                    <div class="flex justify-between items-center">
                        <p class="text-gray-500 text-xs font-semibold uppercase tracking-wider">Faltas (No-Show)</p>
                        <i class="fas fa-user-clock text-orange-400 text-base"></i>
                    </div>
                    <h3 class="text-4xl font-extrabold mt-2 dark:text-white tracking-tight">4</h3>
                    <p class="text-gray-400 text-[11px] mt-1"><span class="text-orange-600 font-bold">R$ 640</span> não realizados</p>
                </div>
                <div class="bg-white dark:bg-gray-900 p-6 rounded-[2rem] shadow-sm border border-gray-100 dark:border-gray-800 card-hover-effect">
                    <p class="text-gray-500 text-xs font-semibold uppercase tracking-wider">Faturamento</p>
                    <h3 class="text-4xl font-extrabold mt-2 tracking-tight bg-gradient-to-r from-blue-600 to-emerald-500 bg-clip-text text-transparent">R$ 1.250</h3>
                    <span class="text-gray-400 text-[11px] font-medium block mt-1">8 sessões liquidadas</span>
                </div>
            </div>
<!-- inicio da listagem de pacientes -->
            <div class="grid grid-cols-12 gap-8 items-start mb-12">

                <div class="col-span-12 xl:col-span-9 space-y-8">

                    <div class="bg-gradient-to-br from-emerald-50/30 via-white to-blue-50/30 dark:from-gray-900 dark:to-slate-950 rounded-[2.5rem] p-6 xl:p-8 shadow-md border border-gray-200/60 dark:border-gray-800/80 backdrop-blur-sm">

                        <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-4 mb-6">
                            <div>
                                <h2 class="text-xl xl:text-2xl font-extrabold text-gray-950 dark:text-white tracking-tight">Fluxo de Atendimento</h2>
                                <p class="text-gray-500 text-xs mt-0.5">Gerenciamento em tempo real dos prontuários e pacientes ativos.</p>
                            </div>

                            <div class="flex bg-gray-100/80 dark:bg-gray-800/80 p-1 rounded-2xl border border-gray-200/50 dark:border-gray-700 shadow-inner" id="filtro-container">
                                <button onclick="filtrarTabelaTerapeutica('dia')" data-filtro="dia"
                                   class="filtro-btn px-4 py-2 rounded-xl text-xs font-bold transition-all <%= locals.filtroAtivo === 'dia' ? 'bg-white dark:bg-gray-700 shadow-sm text-blue-600 dark:text-white border border-gray-100 dark:border-transparent' : 'text-gray-400 hover:text-gray-600 dark:hover:text-gray-300' %>">
                                    Hoje
                                </button>
                                <button onclick="filtrarTabelaTerapeutica('semana')" data-filtro="semana"
                                   class="filtro-btn px-4 py-2 rounded-xl text-xs font-bold transition-all <%= locals.filtroAtivo === 'semana' ? 'bg-white dark:bg-gray-700 shadow-sm text-blue-600 dark:text-white border border-gray-100 dark:border-transparent' : 'text-gray-400 hover:text-gray-600 dark:hover:text-gray-300' %>">
                                    Semana
                                </button>
                                <button onclick="filtrarTabelaTerapeutica('mes')" data-filtro="mes"
                                   class="filtro-btn px-4 py-2 rounded-xl text-xs font-bold transition-all <%= locals.filtroAtivo === 'mes' ? 'bg-white dark:bg-gray-700 shadow-sm text-blue-600 dark:text-white border border-gray-100 dark:border-transparent' : 'text-gray-400 hover:text-gray-600 dark:hover:text-gray-300' %>">
                                    Mês
                                </button>
                                <button onclick="filtrarTabelaTerapeutica('ano')" data-filtro="ano"
                                   class="filtro-btn px-4 py-2 rounded-xl text-xs font-bold transition-all <%= locals.filtroAtivo === 'ano' ? 'bg-white dark:bg-gray-700 shadow-sm text-blue-600 dark:text-white border border-gray-100 dark:border-transparent' : 'text-gray-400 hover:text-gray-600 dark:hover:text-gray-300' %>">
                                    Ano
                                </button>
                            </div>

                            <button onclick="window.print()" class="flex items-center gap-2 bg-white hover:bg-gray-50 dark:bg-gray-800 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-200 text-xs font-bold px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 transition-all shadow-sm">
                                <i class="fas fa-print text-blue-500"></i> Imprimir Lista
                            </button>
                        </div>

                        <div class="overflow-x-auto rounded-2xl border border-gray-200/70 dark:border-gray-800/80 bg-white/60 dark:bg-gray-900/40 shadow-inner">
                            <table class="w-full text-left border-collapse table-fixed">
                                <thead>
                                    <tr class="bg-gray-100/70 dark:bg-gray-800/60 border-b border-gray-200 dark:border-gray-800">
                                        <th class="px-6 py-4 text-xs font-extrabold uppercase tracking-wider text-gray-500 dark:text-gray-400 w-[60px]">ID</th>
                                        <th class="px-6 py-4 text-xs font-extrabold uppercase tracking-wider text-gray-500 dark:text-gray-400 min-w-[200px]">Paciente</th>
                                        <th class="px-6 py-4 text-xs font-extrabold uppercase tracking-wider text-gray-500 dark:text-gray-400 w-[170px]">Data e Hora</th>
                                        <th class="px-6 py-4 text-xs font-extrabold uppercase tracking-wider text-gray-500 dark:text-gray-400 w-[140px]">Terapia</th>
                                        <th class="px-6 py-4 text-xs font-extrabold uppercase tracking-wider text-gray-500 dark:text-gray-400 w-[130px]">Status</th>
                                        <th class="px-6 py-4 text-xs font-extrabold uppercase tracking-wider text-gray-500 dark:text-gray-400 w-[140px] text-right">Ações</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-200/60 dark:divide-gray-800/60" id="tabela-pacientes-body">
                                    <% if (locals.agendamentos && agendamentos.length > 0) { %>
                                        <% agendamentos.forEach(agendamento => { %>
                                            <tr class="hover:bg-white/80 dark:hover:bg-gray-800/40 transition-all group">
                                                <td class="px-6 py-4 text-sm font-semibold text-gray-400 dark:text-gray-600 truncate">#<%= agendamento.id %></td>
                                                <td class="px-6 py-4">
                                                    <div class="font-bold text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors truncate text-sm"><%= agendamento.nome %></div>
                                                    <div class="text-xs text-gray-400 dark:text-gray-500 mt-0.5 flex items-center gap-1 truncate">
                                                        <i class="fab fa-whatsapp text-emerald-500"></i> <%= agendamento.telefone %>
                                                    </div>
                                                </td>

                                                <td class="px-6 py-4 text-sm font-medium">
                                                    <div class="font-bold text-gray-900 dark:text-gray-100 tracking-tight text-[14px]">
                                                        <%= new Date(agendamento.data_agendamento).toLocaleDateString('pt-BR') %>
                                                    </div>

                                                    <div class="mt-1.5 inline-flex items-center gap-1.5 bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300 px-2.5 py-1 rounded-lg text-xs font-black border border-blue-100/70 dark:border-blue-900/40 shadow-sm">
                                                        <i class="far fa-clock text-blue-500 text-xs animate-pulse"></i>
                                                        <%= new Date(agendamento.data_agendamento).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }) %> hs
                                                    </div>
                                                </td>

                                                <td class="px-6 py-4 truncate">
                                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-[11px] font-semibold bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 border border-blue-100 dark:border-blue-900/30 max-w-full truncate">
                                                        <%= agendamento.tipo_terapia %>
                                                    </span>
                                                </td>
                                                <td class="px-6 py-4 whitespace-nowrap">
                                                    <%
                                                        let badgeClasses = 'bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300 border-gray-200';
                                                        if(agendamento.status_agendamento === 'confirmado') {
                                                            badgeClasses = 'bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 border-emerald-100 dark:border-emerald-900/30';
                                                        } else if(agendamento.status_agendamento === 'pendente') {
                                                            badgeClasses = 'bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 border-amber-100 dark:border-amber-900/30';
                                                        } else if(agendamento.status_agendamento === 'cancelado') {
                                                            badgeClasses = 'bg-red-50 dark:bg-red-950/40 text-red-600 dark:text-red-400 border-red-100 dark:border-red-900/30';
                                                        }
                                                    %>
                                                    <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-[10px] font-bold uppercase tracking-wider border <%= badgeClasses %>">
                                                        <span class="w-1.5 h-1.5 rounded-full mr-1.5 bg-current animate-pulse"></span>
                                                        <%= agendamento.status_agendamento %>
                                                    </span>
                                                </td>
                                                <td class="px-6 py-4 text-right whitespace-nowrap">
                                                    <button onclick="abrirGavetaProntuario('<%= agendamento.id %>')" class="inline-flex items-center gap-1.5 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 text-xs font-bold px-3 py-2 rounded-xl border border-gray-200 dark:border-gray-700 hover:shadow shadow-sm transition-all">
                                                        Ver Prontuário
                                                    </button>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="6" class="px-6 py-12 text-center">
                                                <div class="flex flex-col items-center justify-center">
                                                    <div class="w-12 h-12 bg-gray-50 dark:bg-gray-800 rounded-full flex items-center justify-center text-gray-400 mb-3 border border-gray-100 dark:border-gray-700">
                                                        <i class="fas fa-calendar-times text-lg"></i>
                                                    </div>
                                                    <p class="text-gray-900 dark:text-white font-semibold text-sm">Nenhum atendimento cadastrado</p>
                                                    <p class="text-gray-400 dark:text-gray-500 text-xs mt-0.5">Sua agenda está livre para este período.</p>
                                                </div>
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="bg-white dark:bg-gray-900 rounded-[2.5rem] p-6 xl:p-8 shadow-sm border border-gray-100 dark:border-gray-800">
                        <div class="flex flex-col sm:flex-row items-center justify-between mb-6 gap-4">
                            <div>
                                <h3 class="text-xl font-bold dark:text-white tracking-tight">Disponibilidade e Janelas</h3>
                                <p id="calendario-mes-ano" class="text-xs text-gray-400 font-medium mt-0.5">Mês de Análise</p>
                            </div>
                            <div class="flex bg-gray-50 dark:bg-gray-800 p-1 rounded-2xl border border-gray-100 dark:border-gray-700">
                                <button onclick="alternarCalendario('semana')" id="btn-semana" class="px-4 py-2 rounded-xl text-xs font-bold transition-all bg-white dark:bg-gray-700 shadow-sm text-blue-600 dark:text-white">
                                    Semana
                                </button>
                                <button onclick="alternarCalendario('mes')" id="btn-mes" class="px-4 py-2 rounded-xl text-xs font-bold transition-all text-gray-400 hover:text-gray-600 dark:hover:text-gray-200">
                                    Mês Inteiro
                                </button>
                            </div>
                        </div>

                        <div id="view-calendario">
                            <div class="grid grid-cols-7 gap-2 mb-3">
                                <div class="text-center text-[10px] font-black text-gray-400 dark:text-gray-500 uppercase">Dom</div>
                                <div class="text-center text-[10px] font-black text-gray-400 dark:text-gray-500 uppercase">Seg</div>
                                <div class="text-center text-[10px] font-black text-gray-400 dark:text-gray-500 uppercase">Ter</div>
                                <div class="text-center text-[10px] font-black text-gray-400 dark:text-gray-500 uppercase">Qua</div>
                                <div class="text-center text-[10px] font-black text-gray-400 dark:text-gray-500 uppercase">Qui</div>
                                <div class="text-center text-[10px] font-black text-gray-400 dark:text-gray-500 uppercase">Sex</div>
                                <div class="text-center text-[10px] font-black text-gray-400 dark:text-gray-500 uppercase">Sáb</div>
                            </div>
                            <div id="grid-dias" class="grid grid-cols-7 gap-2"></div>
                        </div>
                    </div>

                </div>

                <div class="col-span-12 xl:col-span-3 space-y-6">

                    <div id="asidePaciente" class="bg-gradient-to-br from-gray-900 to-slate-950 dark:from-gray-900 dark:to-slate-950 p-6 rounded-[2.5rem] text-white shadow-xl border border-gray-800 transition-all duration-300 relative overflow-hidden">

                        <div class="absolute -right-10 -top-10 w-40 h-40 bg-blue-500/10 rounded-full blur-3xl"></div>
                        <div class="absolute -left-10 -bottom-10 w-40 h-40 bg-emerald-500/10 rounded-full blur-3xl"></div>

                        <div class="flex justify-between items-center mb-6 relative z-10">
                            <span id="infoContadorAside" class="bg-white/10 text-white text-[10px] uppercase tracking-widest font-black px-3 py-1.5 rounded-full border border-white/10">
                                0 de 0 Pacientes
                            </span>
                            <div class="flex gap-1.5">
                                <button onclick="navegarPaciente('anterior')" class="w-8 h-8 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 flex items-center justify-center text-xs transition-colors">
                                    <i class="fas fa-chevron-left"></i>
                                </button>
                                <button onclick="navegarPaciente('proximo')" class="w-8 h-8 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 flex items-center justify-center text-xs transition-colors">
                                    <i class="fas fa-chevron-right"></i>
                                </button>
                            </div>
                        </div>

                        <div class="text-center py-4 relative z-10">
                            <div id="infoIniciaisAside" class="w-16 h-16 bg-gradient-to-tr from-blue-500 to-emerald-400 text-white font-black text-xl rounded-2xl flex items-center justify-center mx-auto shadow-lg tracking-tight mb-4">
                                --
                            </div>
                            <h4 id="infoNomeAside" class="text-lg font-black tracking-tight line-clamp-1">Carregando Paciente...</h4>
                            <p id="infoTerapiaAside" class="text-blue-400 text-xs font-bold uppercase mt-1 tracking-wider">Aguardando Conexão</p>
                        </div>

                        <div class="space-y-3 my-4 pt-4 border-t border-white/5 text-xs text-gray-400 relative z-10">
                            <div class="flex justify-between items-center">
                                <span class="font-medium">Telefone:</span>
                                <span id="infoTelefoneAside" class="text-white font-bold">(00) 00000-0000</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="font-medium">Status da Sessão:</span>
                                <div class="flex items-center gap-1.5">
                                    <i id="infoStatusIconAside" class="fas fa-circle-notch animate-spin text-blue-400 text-xs"></i>
                                    <span id="infoStatusAside" class="text-white font-bold uppercase tracking-wider text-[10px]">Pendente</span>
                                </div>
                            </div>
                        </div>

                        <div class="pt-2 relative z-10">
                            <a id="btnLinkProntuario" href="#" class="flex items-center justify-center gap-2 bg-white text-gray-950 font-black text-xs py-3.5 px-4 rounded-2xl shadow-lg hover:bg-gray-100 transition-all text-center">
                                <i class="fas fa-folder-open"></i> Acessar Prontuário Completo
                            </a>
                        </div>
                    </div>

                    <a href="/configuracoes" class="bg-gradient-to-br from-blue-600 to-emerald-500 p-6 rounded-[2.5rem] shadow-xl shadow-blue-100 dark:shadow-none group hover:scale-[1.02] active:scale-95 transition-all duration-500 flex flex-col justify-center items-center text-center relative overflow-hidden cursor-pointer block">
                        <div class="absolute top-0 -left-full w-full h-full bg-white/20 skew-x-[-25deg] group-hover:left-[150%] transition-all duration-1000 ease-in-out"></div>
                        <div class="relative z-10 flex flex-col items-center">
                            <div class="w-20 h-20 bg-white rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-2xl relative overflow-hidden group-hover:rotate-3 transition-transform duration-500">
                                <img src="/logo/LogoTop2.png" alt="Logo MedLM" class="w-16 h-16 object-contain p-1">
                                <span class="absolute top-1.5 right-1.5 w-2.5 h-2.5 bg-emerald-500 rounded-full border-2 border-white animate-pulse"></span>
                            </div>
                            <h3 class="text-white text-xl font-bold tracking-tight">Med<span class="opacity-75">LM</span></h3>
                            <p class="text-white/80 text-[10px] mt-1 uppercase tracking-[0.15em] font-medium">Painel de Administração</p>
                            <div class="mt-4 flex items-center justify-center gap-1.5 text-[9px] text-white font-bold uppercase py-2 px-4 bg-white/10 rounded-full border border-white/25 hover:bg-white/20 transition">
                                <i class="fas fa-sliders-h"></i> Configurações
                            </div>
                        </div>
                    </a>

                </div>
            </div>
<!-- fim da listagem de pacientes -->
            <div class="border-t border-gray-200/50 dark:border-gray-800/60 pt-8 mt-12">
                <div class="mb-6">
                    <h2 class="text-2xl font-extrabold text-gray-950 dark:text-white tracking-tight">Análise Comparativa Mensal</h2>
                    <p class="text-gray-500 text-xs mt-0.5">Visão isolada do comportamento e volume de consultas divididas por semanas cheias.</p>
                </div>

                <div class="grid grid-cols-1 xl:grid-cols-2 gap-8">
                    <div class="bg-white dark:bg-gray-900 rounded-[2.5rem] p-6 shadow-sm border border-gray-100 dark:border-gray-800 transition hover:shadow-lg duration-500">
                        <div class="flex justify-between items-center mb-4">
                            <div>
                                <h3 class="text-base font-bold dark:text-white tracking-tight text-gray-900">Volume de Atendimentos - Semana 1</h3>
                                <p class="text-gray-400 text-[11px]">Dias 01 a 07 do mês corrente</p>
                            </div>
                        </div>
                        <div id="chart-semana-1" class="min-h-[280px]"></div>
                    </div>

                    <div class="bg-white dark:bg-gray-900 rounded-[2.5rem] p-6 shadow-sm border border-gray-100 dark:border-gray-800 transition hover:shadow-lg duration-500">
                        <div class="flex justify-between items-center mb-4">
                            <div>
                                <h3 class="text-base font-bold dark:text-white tracking-tight text-gray-900">Volume de Atendimentos - Semana 2</h3>
                                <p class="text-gray-400 text-[11px]">Dias 08 a 14 do mês corrente</p>
                            </div>
                        </div>
                        <div id="chart-semana-2" class="min-h-[280px]"></div>
                    </div>

                    <div class="bg-white dark:bg-gray-900 rounded-[2.5rem] p-6 shadow-sm border border-gray-100 dark:border-gray-800 transition hover:shadow-lg duration-500">
                        <div class="flex justify-between items-center mb-4">
                            <div>
                                <h3 class="text-base font-bold dark:text-white tracking-tight text-gray-900">Volume de Atendimentos - Semana 3</h3>
                                <p class="text-gray-400 text-[11px]">Dias 15 a 21 do mês corrente</p>
                            </div>
                        </div>
                        <div id="chart-semana-3" class="min-h-[280px]"></div>
                    </div>

                    <div class="bg-white dark:bg-gray-900 rounded-[2.5rem] p-6 shadow-sm border border-gray-100 dark:border-gray-800 transition hover:shadow-lg duration-500">
                        <div class="flex justify-between items-center mb-4">
                            <div>
                                <h3 class="text-base font-bold dark:text-white tracking-tight text-gray-900">Volume de Atendimentos - Semana 4</h3>
                                <p class="text-gray-400 text-[11px]">Dias 22 ao fim do mês corrente</p>
                            </div>
                        </div>
                        <div id="chart-semana-4" class="min-h-[280px]"></div>
                    </div>
                </div>
            </div>

        </main>
    </div>

    <!-- Slide para ver prontuario -->
    <div id="gaveta-prontuario" class="fixed inset-0 z-50 invisible transition-all duration-300">
        <div id="gaveta-backdrop" class="absolute inset-0 bg-gray-900/40 backdrop-blur-sm opacity-0 transition-opacity duration-300"></div>

        <div id="gaveta-painel" class="absolute inset-y-0 left-0 w-full max-w-lg bg-gradient-to-b from-white to-gray-50 dark:from-gray-900 dark:to-slate-950 shadow-2xl border-r border-gray-200 dark:border-gray-800 transform -translate-x-full transition-transform duration-300 flex flex-col">

            <div class="p-6 border-b border-gray-100 dark:border-gray-800 flex justify-between items-center bg-white dark:bg-gray-900/50">
                <div>
                    <span class="text-[10px] uppercase font-black tracking-widest text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-950/50 px-2 py-0.5 rounded">Ficha Clínica</span>
                    <h3 id="gaveta-paciente-nome" class="text-lg font-black text-gray-900 dark:text-white mt-1">Carregando...</h3>
                </div>
                <button onclick="fecharGavetaProntuario()" class="w-8 h-8 rounded-xl flex items-center justify-center bg-gray-100 dark:bg-gray-800 text-gray-500 hover:text-red-500 transition-colors">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="p-6 overflow-y-auto flex-1 space-y-6 text-sm text-gray-600 dark:text-gray-400">
                <div class="grid grid-cols-2 gap-4 bg-white dark:bg-gray-800/40 p-4 rounded-2xl border border-gray-100 dark:border-gray-800/80 shadow-sm">
                    <div>
                        <span class="text-xs text-gray-400 font-semibold block">Data e Hora</span>
                        <span id="gaveta-paciente-data" class="font-bold text-gray-800 dark:text-gray-200">-</span>
                    </div>
                    <div>
                        <span class="text-xs text-gray-400 font-semibold block">Terapia</span>
                        <span id="gaveta-paciente-terapia" class="font-bold text-blue-600 dark:text-blue-400">-</span>
                    </div>
                    <div>
                        <span class="text-xs text-gray-400 font-semibold block">WhatsApp</span>
                        <span id="gaveta-paciente-whats" class="font-bold text-gray-800 dark:text-gray-200">-</span>
                    </div>
                    <div>
                        <span class="text-xs text-gray-400 font-semibold block">CPF</span>
                        <span id="gaveta-paciente-cpf" class="font-bold text-gray-800 dark:text-gray-200">-</span>
                    </div>
                </div>

                <div class="grid grid-cols-3 gap-2 text-center text-xs">
                    <div class="bg-gray-50 dark:bg-gray-800/30 p-2.5 rounded-xl border border-gray-100 dark:border-gray-800">
                        <span class="text-gray-400 block mb-0.5">Idade</span>
                        <strong id="gaveta-paciente-idade" class="text-gray-800 dark:text-gray-200 text-sm">-</strong>
                    </div>
                    <div class="bg-gray-50 dark:bg-gray-800/30 p-2.5 rounded-xl border border-gray-100 dark:border-gray-800">
                        <span class="text-gray-400 block mb-0.5">Peso</span>
                        <strong id="gaveta-paciente-peso" class="text-gray-800 dark:text-gray-200 text-sm">-</strong>
                    </div>
                    <div class="bg-gray-50 dark:bg-gray-800/30 p-2.5 rounded-xl border border-gray-100 dark:border-gray-800">
                        <span class="text-gray-400 block mb-0.5">Altura</span>
                        <strong id="gaveta-paciente-altura" class="text-gray-800 dark:text-gray-200 text-sm">-</strong>
                    </div>
                </div>

                <div class="space-y-1.5">
                    <label class="text-xs font-bold text-gray-400 uppercase tracking-wider">Queixa Principal / Motivo</label>
                    <div id="gaveta-paciente-motivo" class="p-4 bg-white dark:bg-gray-800/50 rounded-2xl border border-gray-100 dark:border-gray-800/60 leading-relaxed min-h-[60px] italic"></div>
                </div>

                <div class="space-y-1.5">
                    <label class="text-xs font-bold text-gray-400 uppercase tracking-wider">Condições Pré-existentes</label>
                    <div id="gaveta-paciente-condicoes" class="p-4 bg-white dark:bg-gray-800/50 rounded-2xl border border-gray-100 dark:border-gray-800/60 leading-relaxed"></div>
                </div>

                <div class="space-y-1.5 pt-2">
                    <label class="text-xs font-bold text-gray-400 uppercase tracking-wider flex items-center gap-1">
                        <i class="fas fa-pen text-blue-500"></i> Observações / Evolução do Atendimento
                    </label>
                    <textarea id="gaveta-paciente-obs" class="w-full p-4 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm min-h-[120px] shadow-inner" placeholder="Digite as anotações desta sessão clínica..."></textarea>
                </div>
            </div>

            <div class="p-4 border-t border-gray-100 dark:border-gray-800 bg-white dark:bg-gray-900 flex gap-3">
                <button class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-4 rounded-xl text-xs transition-colors shadow-sm">
                    Salvar Evolução
                </button>
            </div>
        </div>
    </div>
    <!-- fim do slide ver prontuario -->

    <script>
        window.listaAgendamentosReais = <%- locals.agendamentos ? JSON.stringify(agendamentos) : '[]' %>;
        window.dadosAgendamentosReais = <%- locals.resumoMensal ? JSON.stringify(resumoMensal) : '{}' %>;
        window.dadosComparativoMensal = <%- locals.dadosComparativoMensal ? JSON.stringify(dadosComparativoMensal) : 'null' %>;
    </script>
    <script src="../ScriptGlobal/dashboardScript.js" defer></script>
    <script src="../ScriptGlobal/logout.js"></script>
    <script src="../ScriptGlobal/BloqBotVoltar.js"></script>
</body>
</html>