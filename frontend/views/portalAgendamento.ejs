<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Agendamento | <%= clinica.nome %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        :root { --glass-bg: rgba(255, 255, 255, 0.7); --glass-border: rgba(255, 255, 255, 0.3); }
        @media (prefers-color-scheme: dark) {
            :root { --glass-bg: rgba(30, 41, 59, 0.7); --glass-border: rgba(255, 255, 255, 0.1); }
            body { background-color: #0f172a; color: white; }
        }

        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; transition: background 0.3s ease; }

        .glass {
            background: var(--glass-bg);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border: 1px solid var(--glass-border);
            border-radius: 2rem;
        }

        .step { display: none; transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1); }
        .step.active { display: block; animation: slideUp 0.5s ease-out; }

        @keyframes slideUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .ios-input {
            background: rgba(120, 120, 128, 0.1);
            border: none;
            border-radius: 12px;
            padding: 14px;
            width: 100%;
            transition: all 0.2s;
        }
        .ios-input:focus { outline: 2px solid #007aff; background: rgba(120, 120, 128, 0.05); }
    </style>
</head>
<body class="bg-slate-100 text-slate-900 p-4">

    <!-- Header Estilo Apple -->
    <header class="max-w-lg mx-auto py-8 text-center">
        <h1 class="text-3xl font-extrabold tracking-tight"><%= clinica.nome %></h1>
        <p class="text-slate-500 dark:text-slate-400 mt-2">Escolha o melhor momento para você.</p>
    </header>

    <main class="max-w-lg mx-auto">
        <!-- Progress Bar -->
        <div class="flex justify-between mb-8 px-8 relative">
            <div id="prog-bar" class="absolute top-1/2 left-8 right-8 h-1 bg-slate-200 dark:bg-slate-700 -z-10 transform -translate-y-1/2"></div>
            <div class="step-dot bg-blue-600 w-8 h-8 rounded-full flex items-center justify-center text-white text-sm font-bold shadow-lg">1</div>
            <div class="step-dot bg-slate-300 w-8 h-8 rounded-full flex items-center justify-center text-white text-sm font-bold shadow-lg" id="dot-2">2</div>
            <div class="step-dot bg-slate-300 w-8 h-8 rounded-full flex items-center justify-center text-white text-sm font-bold shadow-lg" id="dot-3">3</div>
        </div>

        <!-- FORMULARIO -->
        <form id="agendamentoForm">
            <!-- PASSO 1: DADOS PESSOAIS -->
            <section id="step1" class="step active glass p-8 shadow-2xl">
                <div class="flex items-center mb-6">
                    <i class="fas fa-user-circle text-2xl text-blue-500 mr-3"></i>
                    <h2 class="text-xl font-bold">Dados Pessoais</h2>
                </div>

                <div class="space-y-4">
                    <input type="text" id="nome" name="nome" placeholder="Nome Completo" class="ios-input dark:text-white" required>
                    <div class="grid grid-cols-2 gap-3">
                        <input type="email" id="email" name="email" placeholder="E-mail" class="ios-input dark:text-white" required>
                        <input type="tel" id="telefone" name="telefone" placeholder="WhatsApp" class="ios-input dark:text-white" required>
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <input type="text" id="cpf" name="cpf" placeholder="CPF" class="ios-input dark:text-white" required>
                        <input type="date" id="data_nascimento" name="data_nascimento" class="ios-input dark:text-white">
                    </div>
                    <select id="genero" name="genero" class="ios-input dark:text-white">
                        <option value="">Selecione o Gênero</option>
                        <option value="Masculino">Masculino</option>
                        <option value="Feminino">Feminino</option>
                        <option value="Outro">Outro</option>
                    </select>
                </div>

                <button type="button" onclick="goToStep(2)" class="w-full mt-8 bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 rounded-2xl shadow-xl transition-all active:scale-95">
                    Continuar
                </button>
            </section>

            <!-- PASSO 2: AGENDAMENTO -->
            <section id="step2" class="step glass p-8 shadow-2xl">
                <div class="flex items-center mb-6">
                    <button type="button" onclick="goToStep(1)" class="mr-4 text-blue-500"><i class="fas fa-chevron-left"></i></button>
                    <h2 class="text-xl font-bold">Data e Horário</h2>
                </div>

                <input type="date" id="data_escolhida" onchange="carregarHorarios()" class="ios-input mb-6 dark:text-white">

                <div id="container_horarios" class="grid grid-cols-3 gap-3 max-h-64 overflow-y-auto pr-2">
                    <!-- Dinâmico -->
                </div>

                <div class="mt-6 space-y-4">
                    <input type="text" id="tipo_terapia" placeholder="Tipo de Terapia (Opcional)" class="ios-input dark:text-white">
                    <textarea id="motivo_consulta" placeholder="Motivo da consulta" class="ios-input dark:text-white h-20"></textarea>
                </div>

                <button type="button" id="btn-next-3" onclick="goToStep(3)" disabled class="w-full mt-8 bg-slate-400 text-white font-bold py-4 rounded-2xl shadow-xl transition-all">
                    Revisar Agendamento
                </button>
            </section>

            <!-- PASSO 3: PAGAMENTO (SINAL) -->
            <section id="step3" class="step glass p-8 shadow-2xl">
                <div class="text-center mb-6">
                    <div class="w-16 h-16 bg-green-100 dark:bg-green-900/30 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="fas fa-check text-2xl text-green-500"></i>
                    </div>
                    <h2 class="text-xl font-bold">Quase Finalizado!</h2>
                    <p class="text-sm text-slate-500 mt-2">Seu horário foi reservado com sucesso.</p>
                </div>

                <!-- Card de Pagamento Voluntário -->
                <div class="bg-blue-600 rounded-3xl p-6 text-white mb-6 relative overflow-hidden shadow-xl">
                    <div class="relative z-10">
                        <p class="text-xs uppercase tracking-widest opacity-80">Sinal Sugerido</p>
                        <h3 class="text-4xl font-black mt-1">R$ <%= config.valor_sinal || '0,00' %></h3>
                        <p class="text-[10px] mt-4 leading-tight opacity-90">
                            * O pagamento do sinal é <strong>voluntário</strong>. Pacientes que confirmam o sinal possuem prioridade de atendimento na clínica.
                        </p>
                    </div>
                    <i class="fas fa-shield-alt absolute -bottom-4 -right-4 text-8xl opacity-10"></i>
                </div>

                <div class="grid grid-cols-1 gap-4">
                    <button type="button" onclick="abrirModalPagamento()" class="w-full bg-slate-900 dark:bg-white dark:text-slate-900 text-white font-bold py-4 rounded-2xl flex items-center justify-center gap-2">
                        <i class="fab fa-pix"></i> Pagar Sinal Agora
                    </button>
                    <button type="button" onclick="finalizarSemPagamento()" class="w-full bg-transparent border-2 border-slate-200 text-slate-500 py-3 rounded-2xl text-sm font-medium">
                        Confirmar sem pagar sinal
                    </button>
                </div>
            </section>
        </form>
    </main>

    <!-- MODAL DE PAGAMENTO (ESTILO IOS) -->
    <div id="modalPagamento" class="fixed inset-0 z-50 flex items-end sm:items-center justify-center p-4 bg-black/50 hidden backdrop-blur-sm">
        <div class="glass w-full max-w-md p-8 animate-slide-up shadow-2xl bg-white dark:bg-slate-800">
            <div class="w-12 h-1 bg-slate-300 mx-auto rounded-full mb-6 sm:hidden"></div>
            <h3 class="text-2xl font-bold mb-4 text-center">Pagamento via Pix</h3>

            <div class="bg-white p-4 rounded-2xl inline-block mx-auto w-full text-center">
                <!-- API de QR Code que você já usa -->
                <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=COPIA_E_COLA_PIX_AQUI" alt="QR Code" class="mx-auto mb-4">
                <code class="text-[10px] bg-slate-100 p-2 block rounded break-all text-slate-600">00020126360014br.gov.bcb.pix0114...</code>
            </div>

            <button onclick="finalizarAgendamentoCompleto('sinal_pago')" class="w-full mt-6 bg-blue-600 text-white font-bold py-4 rounded-2xl">
                Já realizei o pagamento
            </button>
            <button onclick="fecharModal()" class="w-full mt-2 text-slate-400 py-2 text-sm">Cancelar</button>
        </div>
    </div>

    <script>
        let dados = { clinica_id: "<%= clinica.id %>", horario: "" };

        function goToStep(step) {
            document.querySelectorAll('.step').forEach(s => s.classList.remove('active'));
            document.getElementById('step' + step).classList.add('active');

            // Update dots
            if(step >= 2) document.getElementById('dot-2').classList.add('bg-blue-600');
            if(step >= 3) document.getElementById('dot-3').classList.add('bg-blue-600');
        }

        async function carregarHorarios() {
            const data = document.getElementById('data_escolhida').value;
            const container = document.getElementById('container_horarios');
            container.innerHTML = '<div class="col-span-3 py-4 text-center"><i class="fas fa-spinner fa-spin text-blue-500"></i></div>';

            const resp = await fetch(`/agendar/api/horarios?clinica_id=${dados.clinica_id}&data=${data}`);
            const json = await resp.json();

            container.innerHTML = '';
            json.horarios.forEach(h => {
                const btn = document.createElement('button');
                btn.type = "button";
                btn.innerText = h;
                btn.className = "p-3 rounded-xl border-2 border-slate-100 dark:border-slate-700 font-bold transition-all hover:border-blue-500 active:scale-90 dark:text-white";
                btn.onclick = () => {
                    document.querySelectorAll('#container_horarios button').forEach(b => b.classList.replace('bg-blue-600', 'bg-transparent'));
                    btn.classList.replace('bg-transparent', 'bg-blue-600');
                    btn.classList.add('text-white');
                    dados.horario = h;
                    document.getElementById('btn-next-3').disabled = false;
                    document.getElementById('btn-next-3').classList.replace('bg-slate-400', 'bg-blue-600');
                };
                container.appendChild(btn);
            });
        }

        function abrirModalPagamento() { document.getElementById('modalPagamento').classList.remove('hidden'); }
        function fecharModal() { document.getElementById('modalPagamento').classList.add('hidden'); }

        async function finalizarAgendamentoCompleto(statusManual = 'aguardando_sinal') {
            const form = document.getElementById('agendamentoForm');
            const formData = new FormData(form);
            const payload = Object.fromEntries(formData.entries());

            payload.clinica_id = dados.clinica_id;
            payload.horario = dados.horario;
            payload.data = document.getElementById('data_escolhida').value;
            payload.status_agendamento = statusManual;

            const resp = await fetch('/agendar/finalizar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            const res = await resp.json();
            if(res.success) {
                alert('🎉 Agendamento realizado com sucesso!');
                window.location.href = '/sucesso'; // Ou página de obrigado
            }
        }

        function finalizarSemPagamento() {
            if(confirm("Deseja confirmar seu agendamento sem o pagamento do sinal?")) {
                finalizarAgendamentoCompleto('aguardando_sinal');
            }
        }
    </script>
</body>
</html>