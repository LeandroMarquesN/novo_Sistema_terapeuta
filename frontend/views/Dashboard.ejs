    <!--  =========== MODAIS QUE FICAM  ESCONDIDO E SO APARECEM QUANDO CLICAMOS ===== -->

            <!-- 0.1 MoDAL DA AGENDA -->
            <div id="modalPaciente" class="fixed inset-0 z-[100] hidden flex items-center justify-center p-4 bg-gray-900/20 backdrop-blur-sm transition-all">

              <div class="bg-white dark:bg-gray-900 w-full max-w-md rounded-[2.5rem] shadow-2xl border border-white/20 overflow-hidden transform scale-95 opacity-0 transition-all duration-300" id="modalContent">

                  <div class="bg-gradient-to-r from-blue-600 to-emerald-500 p-8 text-white relative">
                      <button onclick="fecharModal()" class="absolute top-6 right-6 hover:rotate-90 transition-transform">
