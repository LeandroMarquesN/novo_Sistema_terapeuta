    <script>
      tailwind.config = {
          darkMode: 'class',
          theme: {
              extend: {
                  fontFamily: {
                      sans: ['Poppins', 'sans-serif'],
                  },
                  animation: {
                      'gradient-x': 'gradient-x 15s ease infinite',
                      'gradient-y': 'gradient-y 15s ease infinite',
                      'gradient-xy': 'gradient-xy 15s ease infinite',
                  },
                  keyframes: {
                      'gradient-x': {
                          '0%, 100%': { 'background-size': '200% 200%', 'background-position': 'left center' },
                          '50%': { 'background-size': '200% 200%', 'background-position': 'right center' }
                      },
                      'gradient-y': {
                          '0%, 100%': { 'background-size': '200% 200%', 'background-position': 'center top' },
                          '50%': { 'background-size': '200% 200%', 'background-position': 'center bottom' }
                      },
                      'gradient-xy': {
                          '0%, 100%': { 'background-size': '400% 400%', 'background-position': 'left center' },
                          '50%': { 'background-size': '400% 400%', 'background-position': 'right center' }
                      }
                  }
              }
          }
      }
  </script>


    <style>

        /* ---- Logo ---- */
         /* Faz o ícone pulsar levemente ou brilhar ao passar o mouse */
    .h-24 div.bg-gradient-to-br {
        position: relative;
        overflow: hidden;
        transition: transform 0.3s ease;
    }

    .h-24:hover div.bg-gradient-to-br {
        transform: scale(1.1) rotate(-5deg); /* Dá um charme extra no hover */
    }

    /* Brilho passando pelo quadradinho */
    .h-24 div.bg-gradient-to-br::after {
        content: "";
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(
            to right,
            rgba(255, 255, 255, 0) 0%,
            rgba(255, 255, 255, 0.3) 50%,
            rgba(255, 255, 255, 0) 100%
        );
        transform: skewX(-25deg);
    }

    .h-24:hover div.bg-gradient-to-br::after {
        left: 100%;
        transition: all 0.6s ease;
    }


        /* ----Background efeito e Dark mode do Botao --> */
              .bg-mesh-gradient {
        /* ADICIONE ESTA LINHA ABAIXO */
        background-size: 400% 400% !important;

        background-color: #70c2f9;
        background-image:
            radial-gradient(at 10% 10%, rgba(56, 189, 248, 0.15) 0px, transparent 50%),
            radial-gradient(at 90% 10%, rgba(16, 185, 129, 0.1) 0px, transparent 50%),
            radial-gradient(at 50% 50%, rgba(240, 249, 255, 0.5) 0px, transparent 50%),
            radial-gradient(at 10% 90%, rgba(110, 231, 183, 0.15) 0px, transparent 50%),
            radial-gradient(at 90% 90%, rgba(14, 165, 233, 0.1) 0px, transparent 50%);
        }

    .dark .bg-mesh-gradient {
        /* ADICIONE TAMBÉM NO MODO ESCURO */
        background-size: 400% 400%;

        background-color: #030712;
        background-image:
            radial-gradient(at 10% 10%, rgba(14, 165, 233, 0.15) 0px, transparent 50%),
            radial-gradient(at 90% 10%, rgba(5, 150, 105, 0.1) 0px, transparent 50%),
            radial-gradient(at 50% 50%, rgba(3, 7, 18, 0.5) 0px, transparent 50%),
            radial-gradient(at 10% 90%, rgba(16, 185, 129, 0.15) 0px, transparent 50%),
            radial-gradient(at 90% 90%, rgba(56, 189, 248, 0.1) 0px, transparent 50%);
    }
    /* ---- Efeitos dos cards ---- */

    /* Faz todos os cards subirem levemente no hover */
    .grid > div {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        cursor:pointer;
    }
    .grid > div:hover {
        transform: translateY(-8px);
    }

    </style>

